# Phase 1 deployment.
# Copy to .env on the VM, then run scripts/bootstrap-env.sh once to fill the
# generated secrets. Keep this file shell-compatible: KEY=value, no spaces.

COMPOSE_PROJECT_NAME=carve
# Default is managed Postgres from Terraform. Set COMPOSE_PROFILES=local-db only
# for a temporary all-in-one VM fallback.
COMPOSE_PROFILES=

IMAGE_REGISTRY=ghcr.io/carve-app/carve
IMAGE_TAG=latest

WEB_DOMAIN=carve.app
API_DOMAIN=api.carve.app
MEDIA_UPLOAD_DOMAIN=media-upload.carve.app
ACME_EMAIL=ops@carve.app

POSTGRES_USER=carve
POSTGRES_DB=carve
POSTGRES_PASSWORD=__CHANGE_ME_POSTGRES_PASSWORD__
DATABASE_URL=__CHANGE_ME_DATABASE_URL__

JWT_SECRET=__CHANGE_ME_JWT_SECRET__
METRICS_TOKEN=__CHANGE_ME_METRICS_TOKEN__
NLP_INTERNAL_SECRET=__CHANGE_ME_NLP_INTERNAL_SECRET__
MEDIA_INTERNAL_TOKEN=__CHANGE_ME_MEDIA_INTERNAL_TOKEN__

APP_BASE_URL=https://carve.app
ALLOWED_ORIGINS=https://carve.app,https://www.carve.app
NLP_SERVICE_URL=http://nlp:8001
MEDIA_SERVICE_URL=http://media:8002

STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_BUCKET=carve-prod-media
R2_PUBLIC_BASE=https://media.carve.app
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional Google service account. Mount/provide the JSON path yourself before
# setting GOOGLE_APPLICATION_CREDENTIALS inside containers.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# Optional feature keys.
ANTHROPIC_API_KEY=
STT_BACKEND_URL=
STT_BACKEND_KEY=

# Optional weekly email digest.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database backups. With managed Postgres, this is a logical dump in addition
# to RDS automated backups/PITR. If R2_BACKUP_BUCKET is set, backup-postgres.sh
# uploads compressed dumps via the S3-compatible R2 API.
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=14
R2_BACKUP_BUCKET=
R2_BACKUP_PREFIX=phase1/postgres
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

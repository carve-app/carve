{
  "name": "carve",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @carve/web dev",
    "dev:ext": "pnpm --filter @carve/extension dev",
    "lint": "eslint apps/web/src apps/extension/src e2e/tests e2e/playwright.config.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @carve/web test && pnpm --filter @carve/extension test",
    "test:coverage": "pnpm --filter @carve/web test:coverage && pnpm --filter @carve/extension test:coverage",
    "test:fast": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:flow-docs": "node scripts/verify-flow-inventory.mjs"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@lhci/cli": "0.13.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.3.0",
    "svelte-eslint-parser": "^1.6.0",
    "typescript-eslint": "^8.62.0",
    "typescript": "^5.8.3"
  }
}
